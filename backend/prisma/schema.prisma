datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Jogador {
  id     String @id @default(cuid())
  nome   String
  pontos Int    @default(0)
}

model Partida {
  id        String   @id @default(cuid())
  status    String   @default("aguardando")
  tabuleiro String
  criadoEm  DateTime @default(now())
}

model JogadorPartida {
  id         String @id @default(cuid())
  jogadorId  String
  partidaId  String
  erros      Int    @default(0)
  jogadas    Int    @default(0)
}